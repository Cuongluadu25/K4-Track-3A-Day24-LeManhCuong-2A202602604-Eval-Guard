# Required — key của provider LLM (lab dùng OpenCode Go, OpenAI-compatible)
OPENAI_API_KEY=

# Endpoint OpenAI-compatible. OpenCode Go: https://opencode.ai/zen/go/v1
# Để trống nếu dùng api.openai.com mặc định.
OPENAI_BASE_URL=

# Header SDK gửi kèm mọi request (định dạng "Tên: giá trị", nhiều dòng cách nhau bằng \n).
# OpenCode Go BẮT BUỘC x-opencode-session, thiếu là HTTP 400 MissingSessionID.
OPENAI_CUSTOM_HEADERS=

# Model: model chính + model dự phòng khi model chính lỗi giữa batch.
LLM_MODEL=longcat-2.5-preview-free
FALLBACK_MODEL=glm-5.3-flash

# Embedding cho retrieval + RAGAS answer_relevancy.
# OpenCode Go KHÔNG có /v1/embeddings -> dùng LM Studio local.
EMBED_BACKEND=lmstudio
EMBEDDING_MODEL=text-embedding-bge-m3
RAGAS_EMBEDDING_MODEL=text-embedding-bge-m3
LOCAL_EMBED_BASE_URL=http://127.0.0.1:1234/v1
LOCAL_EMBED_API_KEY=

# Số request song song khi chấm RAGAS (provider free nên để 4, không tăng lên 16).
RAGAS_MAX_WORKERS=4

# m5 enrichment: mỗi chunk = 1 LLM call. Đặt off cho lượt chạy answers đầu tiên
# (setup dùng chunk gốc; enrich_chunks trả [] là fallback hợp lệ theo PIPELINE_INTERFACE.md).
M5_ENRICHMENT=on

# Optional: HuggingFace token (only if using HF Inference Endpoints)
HF_TOKEN=
