# ── LLM endpoint (OpenAI-compatible) ────────────────────────────────────────
# Cả SDK openai lẫn langchain_openai đều đọc các biến này, nên đổi nhà cung cấp
# chỉ cần sửa ở đây. Bỏ trống 2 biến BASE_* nếu dùng thẳng OpenAI.
OPENAI_API_KEY=

# SDK `openai` đọc biến này (openai/_client.py:160)
OPENAI_BASE_URL=

# LangChain / RAGAS đọc biến này (langchain_openai/chat_models/base.py:489)
# và NeMo Guardrails cũng dùng nó qua provider trong guardrails/config.py
OPENAI_API_BASE=

# Tên model thật của endpoint trên. Phải khớp `model:` trong guardrails/config.yml.
LAB_LLM_MODEL=

# Optional: HuggingFace token (only if using HF Inference Endpoints)
HF_TOKEN=
